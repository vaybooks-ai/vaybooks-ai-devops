# Database Configuration
POSTGRES_DB=vaybooks
POSTGRES_USER=vaybooks
POSTGRES_PASSWORD=vaybooks_dev

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production-min-256-bits-long-for-security
JWT_EXPIRATION_MS=86400000

# Storage Configuration
STORAGE_TYPE=LOCAL
STORAGE_LOCAL_PATH=/data/uploads

# AI Configuration (Optional - MVP works without this)
AI_PROVIDER=OPENAI
OPENAI_API_KEY=
AI_MODEL=gpt-4

# Worker Configuration
WORKER_POLL_INTERVAL_MS=5000
WORKER_BATCH_SIZE=10

# Spring Profile
SPRING_PROFILES_ACTIVE=local
