#!/bin/bash

# VayBooks AI - Local Development Script
# Usage: ./dev [command] [options]

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
INFRA_DIR="$(dirname "$SCRIPT_DIR")"
cd "$INFRA_DIR"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Helper functions
log_info() {
    echo -e "${BLUE}[INFO]${NC} $1"
}

log_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

log_warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

# Ensure volumes directory exists
ensure_volumes() {
    log_info "Ensuring volume directories exist..."
    mkdir -p volumes/postgres-data
    mkdir -p volumes/uploads
    log_success "Volume directories ready"
}

# Ensure .env file exists
ensure_env() {
    if [ ! -f .env ]; then
        log_warning ".env file not found, creating from .env.example"
        cp .env.example .env
        log_success "Created .env file - please review and update if needed"
    fi
}

# Command: up
cmd_up() {
    log_info "Starting VayBooks AI local environment..."
    ensure_volumes
    ensure_env
    
    docker-compose up -d
    
    log_success "All services started!"
    echo ""
    log_info "Services:"
    echo "  - Frontend:      http://localhost:5173"
    echo "  - Backend API:   http://localhost:8080"
    echo "  - PostgreSQL:    localhost:5432"
    echo "  - API Debug:     localhost:5005"
    echo "  - Worker Debug:  localhost:5006"
    echo ""
    log_info "Tailing logs (Ctrl+C to stop)..."
    docker-compose logs -f
}

# Command: down
cmd_down() {
    log_info "Stopping VayBooks AI local environment..."
    docker-compose down
    log_success "All services stopped"
}

# Command: logs
cmd_logs() {
    local service=$1
    if [ -z "$service" ]; then
        log_info "Tailing logs for all services..."
        docker-compose logs -f
    else
        log_info "Tailing logs for $service..."
        docker-compose logs -f "$service"
    fi
}

# Command: reset-db
cmd_reset_db() {
    log_warning "This will DELETE all database data!"
    read -p "Are you sure? (yes/no): " confirm
    
    if [ "$confirm" != "yes" ]; then
        log_info "Aborted"
        exit 0
    fi
    
    log_info "Stopping services..."
    docker-compose down
    
    log_info "Removing database volume..."
    rm -rf volumes/postgres-data/*
    
    log_info "Restarting services (migrations will run)..."
    docker-compose up -d
    
    log_success "Database reset complete!"
    log_info "Tailing logs..."
    docker-compose logs -f
}

# Command: rebuild
cmd_rebuild() {
    local service=$1
    
    if [ -z "$service" ]; then
        log_info "Rebuilding all services..."
        docker-compose down
        docker-compose build --no-cache
        docker-compose up -d
        log_success "All services rebuilt and started"
    else
        log_info "Rebuilding $service..."
        docker-compose stop "$service"
        docker-compose build --no-cache "$service"
        docker-compose up -d "$service"
        log_success "$service rebuilt and started"
    fi
    
    log_info "Tailing logs..."
    docker-compose logs -f
}

# Command: ps
cmd_ps() {
    log_info "Service status:"
    docker-compose ps
}

# Command: exec
cmd_exec() {
    local service=$1
    shift
    local command="$@"
    
    if [ -z "$service" ]; then
        log_error "Usage: ./dev exec <service> <command>"
        exit 1
    fi
    
    docker-compose exec "$service" $command
}

# Command: help
cmd_help() {
    cat << EOF
VayBooks AI - Local Development Script

Usage: ./dev [command] [options]

Commands:
  up              Start all services and tail logs
  down            Stop all services
  logs [service]  Tail logs (all services or specific service)
  reset-db        Reset database (WARNING: deletes all data)
  rebuild [svc]   Rebuild and restart (all or specific service)
  ps              Show service status
  exec <svc> cmd  Execute command in service container
  help            Show this help message

Services:
  postgres        PostgreSQL database
  backend-api     Backend API server
  backend-worker  Background job worker
  frontend        Frontend dev server

Examples:
  ./dev up                          # Start everything
  ./dev logs backend-api            # Tail API logs
  ./dev rebuild frontend            # Rebuild frontend only
  ./dev exec postgres psql -U vaybooks  # Connect to database
  ./dev reset-db                    # Fresh database

EOF
}

# Main command dispatcher
case "${1:-help}" in
    up)
        cmd_up
        ;;
    down)
        cmd_down
        ;;
    logs)
        cmd_logs "${2:-}"
        ;;
    reset-db)
        cmd_reset_db
        ;;
    rebuild)
        cmd_rebuild "${2:-}"
        ;;
    ps)
        cmd_ps
        ;;
    exec)
        shift
        cmd_exec "$@"
        ;;
    help|--help|-h)
        cmd_help
        ;;
    *)
        log_error "Unknown command: $1"
        echo ""
        cmd_help
        exit 1
        ;;
esac
