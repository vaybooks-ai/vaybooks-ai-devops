# Production Environment Configuration
# PLACEHOLDER - Configure when deploying to production

# Database (Use RDS in production)
POSTGRES_DB=vaybooks_prod
POSTGRES_USER=vaybooks_prod
POSTGRES_PASSWORD=CHANGE_ME_VERY_SECURE_PASSWORD

# JWT (Use strong secret in production)
JWT_SECRET=CHANGE_ME_VERY_SECURE_JWT_SECRET_MIN_256_BITS

# AWS
AWS_REGION=us-east-1
AWS_S3_BUCKET=vaybooks-prod-uploads

# AI
OPENAI_API_KEY=sk-...

# Frontend
VITE_API_URL=https://api.vaybooks.ai
